rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health test check connection
    match /test/{testId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Site Settings: Public read & management write
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Courses: Public read & management write / delete
    match /courses/{courseId} {
      allow read, write, delete: if true;
    }

    // Teachers: Public read & management write / delete
    match /teachers/{teacherId} {
      allow read, write, delete: if true;
    }

    // Admissions: Public application submission & management operations
    match /admissions/{admissionId} {
      allow read, write, delete: if true;
    }

    // Students: Academy student roster management
    match /students/{studentId} {
      allow read, write, delete: if true;
    }

    // Student Fees: Academy fee tracking
    match /studentFees/{feeId} {
      allow read, write, delete: if true;
    }

    // Announcements & Posters: Public read & management write / delete
    match /announcements/{announcementId} {
      allow read, write, delete: if true;
    }

    // Gallery: Public read & management write / delete
    match /gallery/{imageId} {
      allow read, write, delete: if true;
    }

    // Reviews: Public read & submission; Management moderation / delete
    match /reviews/{reviewId} {
      allow read, write, delete: if true;
    }

    // FAQs: Public read & management write / delete
    match /faqs/{faqId} {
      allow read, write, delete: if true;
    }

    // Contact Messages: Public submission & website viewing / management / delete
    match /contactMessages/{messageId} {
      allow read, write, delete: if true;
    }

    // Chatbot Settings: Public read & management write
    match /chatbotSettings/{settingId} {
      allow read, write, delete: if true;
    }

    // Chat Conversations: Public log & management review / delete
    match /chatConversations/{conversationId} {
      allow read, write, delete: if true;
    }
  }
}
